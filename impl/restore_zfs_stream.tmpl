# This backup was made with BACKUP_MODE=zfs_stream, so it is restored with
# `zfs receive`. Set the options below before restoring:

# The dataset to receive the stream into. Existing data in this dataset will be
# DESTROYED, see the README. Use a fresh pool/dataset, not the one you backed up.
ZFS_RECV_TARGET=tank_restore

# Extra arguments for `zfs receive`. -F is required for the recursive (-R) streams
# this tool sends, -u avoids mounting the received file systems during restore.
ZFS_RECV_EXTRA_ARGS='-F -u'

# Standard or Bulk, Bulk is cheaper
RESTORE_TIER=Bulk

# Dir with at least UPLOAD_LIMIT_MB free space. A subdirectory 'restore_aws_buffer'
# will be DELETED and recreated there!
BUFFER_PATH_BASE='{buffer_path_base}'

# The options below will make sure the backup in this directory gets restored.

# How this backup was made, do not change
BACKUP_MODE=zfs_stream

# The S3 bucket where data is stored
S3_BUCKET={s3_bucket}

# The subdirectory that was used for backup (see your backup config)
BUCKET_DIR={bucket_dir}

# The timestamp of the backup to restore (see your bucket for which are available)
TIMESTAMP={timestamp}
